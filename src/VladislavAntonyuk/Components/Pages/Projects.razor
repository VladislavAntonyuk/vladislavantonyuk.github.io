@page "/projects"
@using VladislavAntonyuk.Components.Navigation
@inherits VladislavAntonyukBaseComponent

<Head Title="Vladislav Antonyuk - Projects" Description="Vladislav Antonyuk - Projects"/>

<PageHero Eyebrow="Portfolio"
          Title="Projects"
          Subtitle="Selected open source and professional work." />

<ProjectsNavigationComponent>
	<ChildContent Context="projects">
		<MudGrid Spacing="4">
			@foreach (var project in projects)
			{
				<MudItem xs="12" sm="6" lg="4">
					<article class="post-card">
						@if (!string.IsNullOrWhiteSpace(project.Image))
						{
							<a href="@project.Link" target="_blank" rel="noopener" class="post-card-media post-card-media--contain" tabindex="-1" aria-hidden="true">
								<img src="@project.Image" alt="@project.Name" loading="lazy" />
							</a>
						}
						<div class="post-card-body">
							<a href="@project.Link" target="_blank" rel="noopener" class="post-card-title truncate">@project.Name</a>
							<p class="post-card-description truncate-3">@project.Description</p>
							<div class="post-card-actions">
								<MudButton Href="@project.Link" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">Open</MudButton>
							</div>
						</div>
					</article>
				</MudItem>
			}
		</MudGrid>
	</ChildContent>
</ProjectsNavigationComponent>
