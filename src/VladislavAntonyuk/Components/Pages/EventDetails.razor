@page "/events/{eventName}"
@using VladislavAntonyuk.Components.Monetization
@inherits VladislavAntonyukBaseComponent

@if (@event is null)
{
	<Head Title="Vladislav Antonyuk - Events" Description="Vladislav Antonyuk - Events" />
	<MudStack AlignItems="AlignItems.Center" Class="pa-6">
		<MudProgressCircular Indeterminate="true" Color="Color.Primary" />
		<MudText Typo="Typo.subtitle1" Class="mt-2">Loading event...</MudText>
	</MudStack>
}
else
{
	var url = urlCreator.Encode("events", @event.Name);
	var title = $"Vladislav Antonyuk - {@event.Name}";
	var description = $"Vladislav Antonyuk - {@event.Description}";

	<Head Title="@title" Description="@description" Image="@(@event.Image)" />

	<article class="article">
		@if (!string.IsNullOrWhiteSpace(@event.Image))
		{
			<img class="article-cover" src="@(@event.Image)" alt="@(@event.Name)" />
		}

		<header class="article-header">
			<div class="event-chips">
				@if (@event.IsUpcoming())
				{
					<MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Bolt">Upcoming</MudChip>
				}
				@if (@event.DateLabel() is { } dateLabel)
				{
					<MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Outlined.CalendarMonth">@dateLabel</MudChip>
				}
				@if (!string.IsNullOrEmpty(@event.Location))
				{
					var mapUrl = $"https://www.google.com/maps?q={Uri.EscapeDataString(@event.Location)}";
					<MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Outlined.Place" Href="@mapUrl" Target="_blank">@(@event.Location)</MudChip>
				}
				<MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Material.Outlined.ConfirmationNumber">@(@event.PriceLabel())</MudChip>
			</div>
			<h1 class="article-title">@(@event.Name)</h1>
			<div class="article-meta">
				@if (@event.IsUpcoming() && @event.CalendarDataUri(navigationManager.ToAbsolute(url)) is { } calendar)
				{
					<MudButton Href="@calendar" download="@(@event.CalendarFileName())" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.EventAvailable">Add to calendar</MudButton>
				}
				else
				{
					<span></span>
				}
				<div class="article-share">
					<ShareButtons Url="@url" Title="@(@event.Name)" />
				</div>
			</div>
		</header>

		<div class="article-body">
			<MudMarkdown Value="@(@event.Description.ReplaceLineEndings())" />
		</div>
	</article>
}

<Ads Slot="1656353485" />