@page "/articles/{id}"
@using GiscusBlazor
@using VladislavAntonyuk.Components.Monetization
@inherits VladislavAntonyukBaseComponent

@if (article is null)
{
    <MudPaper Class="pa-6" Elevation="0" Style="text-align:center;">
        @if (error is null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-4">Loading article...</MudText>
        }
        else
        {
            <Head Title="@urlCreator.Decode(Id)" />
            <Error ErrorText="@error.Message" ErrorTitle="Error" ErrorCode="@error.Code" />
        }
    </MudPaper>
}
else
{
    var url = urlCreator.Encode("articles", article.Name);
    <Head Title="@article.Name" Description="@article.Description" Keywords="@article.Keywords" Image="@article.Image"
          Type="article" PublishedTime="@article.Created" Section="@article.CategoryName" />

    <div class="reading-progress" aria-hidden="true"></div>
	
    <article class="article">
	    @if (!string.IsNullOrWhiteSpace(article.Image))
	    {
		    <img class="article-cover" src="@article.Image" alt="@article.Name" />
	    }

	    <header class="article-header">
		    <MudChip T="string"
		             Size="Size.Small"
		             Variant="Variant.Text"
		             Color="Color.Primary"
		             Icon="@Icons.Material.Outlined.Tag"
		             OnClick="() => FilterCategory(article.CategoryName)">@article.CategoryName</MudChip>
		    <h1 class="article-title">@article.Name</h1>
		    <div class="article-meta">
			    <span class="post-meta-date">
				    <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" />
				    @article.Created.ToString("dd MMMM yyyy")
				    <span class="post-meta-separator">·</span>
				    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
				    @ReadingMinutes(article.Content) min read
			    </span>
			    <div class="article-share">
				    <ShareButtons Url="@url" Title="@article.Name" />
			    </div>
		    </div>
	    </header>

	    @if (toc.Count > 0)
	    {
		    <details class="article-toc" open>
			    <summary>
				    <MudIcon Icon="@Icons.Material.Outlined.FormatListBulleted" Size="Size.Small" />
				    On this page
			    </summary>
			    <ol>
				    @foreach (var entry in toc)
				    {
					    <li class="@(entry.Indented ? "article-toc-sub" : null)">
						    <a href="@($"{navigation.Uri.Split('#')[0]}#{entry.Id}")" @onclick="() => ScrollTo(entry.Id)" @onclick:preventDefault>@entry.Text</a>
					    </li>
				    }
			    </ol>
		    </details>
	    }

	    <div class="article-body">
		    <MudMarkdown Value="@article.Content" />
	    </div>
	    <div class="article-support">
		    <BuyMeACoffee />
	    </div>

	    @if (previousArticle is not null || nextArticle is not null)
	    {
		    <nav class="article-pager" aria-label="More articles">
			    @if (previousArticle is not null)
			    {
				    <a class="article-pager-link" href="@urlCreator.Encode("articles", previousArticle.Name)">
					    <span class="article-pager-label"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> Previous</span>
					    <span class="article-pager-title">@previousArticle.Name</span>
				    </a>
			    }
			    else
			    {
				    <span></span>
			    }
			    @if (nextArticle is not null)
			    {
				    <a class="article-pager-link article-pager-link--next" href="@urlCreator.Encode("articles", nextArticle.Name)">
					    <span class="article-pager-label">Next <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
					    <span class="article-pager-title">@nextArticle.Name</span>
				    </a>
			    }
		    </nav>
	    }
    </article>
}

<Ads Slot="1656353485" />

@if (suggestions.Count > 0)
{
<section class="related">
    <h2 class="section-title">Related articles</h2>

    <MudGrid Spacing="4">
        @foreach (var suggestion in suggestions)
        {
            var url = urlCreator.Encode("articles", suggestion.Name);
            <MudItem xs="12" sm="6">
				<article class="post-card">
                    @if (!string.IsNullOrWhiteSpace(suggestion.Image))
                    {
	                    <a href="@url" class="post-card-media" tabindex="-1" aria-hidden="true">
		                    <img src="@suggestion.Image" alt="@suggestion.Name" loading="lazy" />
	                    </a>
                    }
                    <div class="post-card-body">
	                    <a href="@url" class="post-card-title truncate-2">@suggestion.Name</a>
	                    <p class="post-card-description truncate-2">@suggestion.Description</p>
	                    <div class="post-card-actions">
		                    <MudButton Href="@url" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">Read article</MudButton>
	                    </div>
                    </div>
                </article>
            </MudItem>
        }
    </MudGrid>
</section>
}

@if (article is not null)
{
    <MudPaper Class="comments mt-8 pa-4" Elevation="0" Outlined="true">
        <Giscus Repo="VladislavAntonyuk/vladislavantonyuk.github.io"
                RepoId="R_kgDOImU4iA"
                Category="Announcements"
                CategoryId="DIC_kwDOImU4iM4CYqI2"
                Mapping="Mapping.Title"
                ReactionsEnabled="true"
                EmitMetadata="false"
                InputPosition="InputPosition.Top"
                Theme="preferred_color_scheme"
                Lang="en"
                Loading="Loading.Lazy" />
    </MudPaper>
}
